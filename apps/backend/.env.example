AI_AGENT_ENVIRONMENT=dev
AI_AGENT_DEFAULT_SMALL_MODEL=llama3-8b-8192
AI_AGENT_DEFAULT_LARGE_MODEL=llama3-70b-8192
AI_AGENT_REQUEST_TIMEOUT_SECONDS=15
AI_AGENT_MAX_CONTEXT_CHUNKS=4
AI_AGENT_DATABASE_URL=postgresql+asyncpg://ai_agent:ai_agent@postgres:5432/ai_agent
AI_AGENT_AUTO_CREATE_TABLES=true
AI_AGENT_GROQ_API_KEY=your_groq_api_key_here
